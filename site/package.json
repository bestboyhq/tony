{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "tony-site",
	"version": "1.0.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "pnpm run build && node --test tests/*.test.ts",
		"og": "node scripts/og.ts"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"marked": "^18.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "6.0.3",
		"vite": "^8.3.4"
	}
}
